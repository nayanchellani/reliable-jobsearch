# API Configuration (create your own .env from this)
# Do not commit .env files

# LLM - FreeLLMAPI router
# Host/local dev: http://127.0.0.1:31415
# Docker Desktop: http://host.docker.internal:31415
# Docker network service: http://llm-service:31415
LLM_BASE_URL=http://127.0.0.1:31415
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=auto

# Optional: ATS board tokens (for Greenhouse, Lever, Ashby connectors)
GREENHOUSE_TOKEN=your_greenhouse_token
LEVER_COMPANY=your_lever_company
ASHBY_NAME=your_ashby_board_name

# Optional: Database
DATABASE_URL=sqlite:///./data/jobs.db

# Optional: Search backends
SEARXNG_URL=http://localhost:8080

# Optional: Email/IMAP for job alerts
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_app_password

# Feature flags
ENABLE_LINKEDIN_SCRAPING=false
ENABLE_NAUKRI_SCRAPING=false
ENABLE_GUEST_SCRAPING=false